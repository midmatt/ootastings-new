# Resend API key for the quote-request form (https://resend.com).
# Copy this file to .env.local and paste your key. Without it, form
# submissions return a clear error instead of sending.
RESEND_API_KEY=

# Canonical origin, used for <link rel="canonical">, Open Graph URLs,
# sitemap.xml and robots.txt. Defaults to https://www.ootastings.com (lib/seo.ts).
#
# Leave unset in production. www is the canonical host, verified against the
# live site: www.ootastings.com serves 200 directly, and the apex
# ootastings.com 308-redirects to it. Canonicals must name the final URL, not
# one that redirects.
#
# Set this on preview deployments to the preview origin so previews do not
# canonicalise themselves to production.
NEXT_PUBLIC_SITE_URL=
