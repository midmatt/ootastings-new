# Resend API key for the quote-request form (https://resend.com).
# Copy this file to .env.local and paste your key. Without it, form
# submissions return a clear error instead of sending.
RESEND_API_KEY=

# Canonical origin, used for <link rel="canonical">, Open Graph URLs,
# sitemap.xml and robots.txt. Defaults to https://ootastings.com (lib/seo.ts).
#
# Leave unset once ootastings.com is attached in Vercel. Until then the site
# serves from ootastings-new.vercel.app, and pointing canonicals at a domain
# that does not yet resolve tells Google to index a URL it cannot fetch — so on
# the preview deployment set this to the vercel.app origin instead.
NEXT_PUBLIC_SITE_URL=
